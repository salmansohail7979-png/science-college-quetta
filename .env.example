# Copy this file to ".env" and fill in your values.

# Local MongoDB (open it in MongoDB Compass with: mongodb://127.0.0.1:27017)
MONGODB_URI=mongodb://127.0.0.1:27017/science_college_quetta

# For Vercel use MongoDB Atlas instead, for example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/science_college_quetta?retryWrites=true&w=majority

# Any long random text. Change it before going live.
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Teachers must enter this code when they create an account.
TEACHER_SIGNUP_CODE=SCQ-TEACHER-2026

PORT=5000

# Fill an EMPTY database with demo data automatically on first visit (true/false).
AUTO_SEED=true
